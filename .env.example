# Copy this file to .env and fill in values before running the application.
# .env is excluded from Git — never commit credentials or local paths.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Research Assistant
APP_VERSION=0.1.0
DEBUG=false

# ---------------------------------------------------------------------------
# Development database
# When running via docker-compose.yml, use the service name "db" as the host.
# For local development outside Docker, use "localhost".
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_assistant

# ---------------------------------------------------------------------------
# Test database (integration tests only)
# Started via: docker compose -f docker-compose.test.yml up -d
# Port 5433 avoids conflicts with the development database on 5432.
# This value is read by conftest.py; a safety check ensures it differs
# from DATABASE_URL and contains "test".
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/research_assistant_test

# ---------------------------------------------------------------------------
# Local document storage
# ---------------------------------------------------------------------------
STORAGE_PATH=./storage

# ---------------------------------------------------------------------------
# Embedding model (Phase 3)
# The vector dimension is read from the loaded model — never hardcoded.
# After changing the model, re-index:
#   POST /api/v1/embeddings/reindex   or   python -m app.embeddings.reindex
# Until then, chunks from the old model are excluded from search (never mixed).
#
# Choose a model whose input limit covers CHUNK_SIZE (~500 tokens by default).
# Each model needs its own EMBEDDING_QUERY_PREFIX and CHAT_MIN_RELEVANCE:
#   BAAI/bge-m3              1024 dims, 8192 tokens, multilingual (default)
#                            prefix "", gate 0.45; ~2.2 GB download, slower on CPU
#   BAAI/bge-small-en-v1.5   384 dims, 512 tokens, English only
#                            prefix "Represent this sentence for searching relevant passages: ",
#                            gate ~0.6; questions in other languages are not retrieved
#   sentence-transformers/all-MiniLM-L6-v2 384 dims, 256 tokens (truncates chunks)
# Compare models on your own documents with `python -m app.evaluation` (evaluation/README.md).
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# Pin exact weights with a Hugging Face commit hash (optional)
# EMBEDDING_MODEL_REVISION=
# Where model weights are downloaded (default: ~/.cache/huggingface)
# EMBEDDING_CACHE_DIR=
# Query instruction; empty for bge-m3 (see the model list above)
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Retrieval (Phase 3)
# ---------------------------------------------------------------------------
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MAX_TOP_K=50
# RETRIEVAL_MIN_SCORE=0.0
# RETRIEVAL_CANDIDATE_MULTIPLIER=3
# RETRIEVAL_DEDUP_THRESHOLD=0.9

# ---------------------------------------------------------------------------
# LLM providers (Phase 4)
# The RAG pipeline is provider-agnostic; pick the default here and override per
# request with "model_provider" / "model_name" in POST /api/v1/chat.
# ---------------------------------------------------------------------------
# LLM_DEFAULT_PROVIDER=ollama
# true = cloud providers are never enabled; document text never leaves this machine.
# LLM_LOCAL_ONLY=false
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024

# Ollama (local). Install a model first, e.g.:  ollama pull llama3.2:3b
# When running the backend in Docker, use http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434
# Empty = first installed model
# OLLAMA_DEFAULT_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=180
# Context window in tokens. Ollama's own default can truncate the RAG prompt.
# OLLAMA_NUM_CTX=8192

# OpenAI-compatible cloud API. Enabled only when OPENAI_API_KEY is set (and
# LLM_LOCAL_ONLY is false). When used, the question and retrieved passages are
# sent to this provider; responses report "cloud_processing": true.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=
# Identifier shown in the API, e.g. openai, openrouter, groq
# OPENAI_PROVIDER_NAME=openai
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# "max_completion_tokens" for OpenAI reasoning models; most others use "max_tokens"
# OPENAI_TOKEN_PARAM=max_tokens

# ---------------------------------------------------------------------------
# Chat / RAG (Phase 4)
# ---------------------------------------------------------------------------
# Passages sent to the LLM (empty = RETRIEVAL_TOP_K)
# CHAT_TOP_K=
# Best passage must reach this cosine similarity or the answer is "insufficient
# evidence" without calling the LLM. Depends on the embedding model: 0.45 for
# bge-m3 (calibrated with the evaluation framework), ~0.6 for bge-small-en-v1.5.
# CHAT_MIN_RELEVANCE=0.45
# Earlier messages included as context for follow-up questions
# CHAT_HISTORY_MESSAGES=6
